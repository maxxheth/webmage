# ============================================
# Webmage - Agentic SEO Village Configuration
# ============================================

# Ollama Cloud
OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_MODEL=gpt-oss:120b

# WordPress (target site)
WP_BASE_URL=https://your-wordpress-site.com
WP_USERNAME=admin
WP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Image Generation (optional — Nano Banana / Nano Banana Pro)
# Set ENABLE_IMAGES=true to generate real images via Google AI Studio
ENABLE_IMAGES=false
GOOGLE_AI_STUDIO_API_KEY=your-key-if-using-images
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# Offsite SEO - Make (Integromat) Webhook for Buffer
MAKE_WEBHOOK_URL=https://hook.us1.make.com/your-webhook-id

# Business Info (used for citation + HARO responses)
BUSINESS_NAME=Your Business Name
BUSINESS_PHONE=(555) 555-5555
BUSINESS_ADDRESS=123 Main St, City, ST 12345
BUSINESS_WEBSITE=https://your-site.com
BUSINESS_NICHE=landscaping

# HARO / Journalist Outreach (IMAP inbox monitoring)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=haro-inbox@yourdomain.com
IMAP_PASSWORD=your-app-password
IMAP_MAILBOX=INBOX
HARO_MIN_RELEVANCE=60

# Scrapy Microservice
SCRAPY_URL=http://scrapy:6800

# Multisite Config (set to 'true' to enable config.yaml overrides)
SUPPORT_MULTISITE_CONFIG=false
